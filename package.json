{
  "name": "next-yak-root",
  "version": "0.0.0",
  "private": true,
  "description": "Release branch of the next-yak 10 codemod, which moves projects to @yak/react",
  "license": "MIT",
  "author": "Jan Nicklas",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "build": "pnpm run --filter=next-yak build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && knip",
    "lint:fix": "oxlint --fix",
    "lint:knip": "knip",
    "test": "pnpm -r run \"/test($|:types)/\"",
    "test:integration": "pnpm -r run test:integration",
    "release": "pnpm --filter='./packages/*' run build && npm_config_ignore_scripts=true changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.1"
}
