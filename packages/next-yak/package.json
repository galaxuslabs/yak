{
  "name": "next-yak",
  "version": "9.10.3",
  "description": "next-yak is now @yak/react. This package moves a project from next-yak 9 to @yak/react 10.",
  "keywords": [
    "codemod",
    "css-in-js",
    "migration",
    "next-yak",
    "yak"
  ],
  "homepage": "https://yak.style/docs/migration-from-next-yak",
  "bugs": {
    "url": "https://github.com/galaxuslabs/yak/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jan Nicklas"
  },
  "maintainers": [
    {
      "name": "Luca Schneider"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxuslabs/yak.git#v10",
    "directory": "packages/next-yak"
  },
  "bin": {
    "next-yak": "./dist/cli.js"
  },
  "files": [
    "dist",
    "stub"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./stub/index.js",
      "require": "./stub/index.cjs"
    },
    "./*": {
      "import": "./stub/index.js",
      "require": "./stub/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "test:types": "tsc",
    "prepublishOnly": "node ../../scripts/check-pnpm.js && pnpm test && pnpm test:integration"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@types/node": "catalog:",
    "magic-string": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
